# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# EXPO_PUBLIC_ variables are safe to ship in the app bundle — the anon key
# is designed to be public and relies on Row Level Security to keep data safe.
# Never put the service_role key here or anywhere in this app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials).
# Client IDs are public identifiers and ship in the bundle by design. The Web
# client's *secret* is NOT needed for native sign-in — don't add it here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
