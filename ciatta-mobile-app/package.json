{
  "name": "ciatta-mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "^57.0.0",
    "expo-apple-authentication": "^57.0.1",
    "expo-build-properties": "~57.0.9",
    "expo-calendar": "~57.0.2",
    "expo-dev-client": "~57.0.10",
    "expo-device": "^57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-notifications": "^57.0.11",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.13",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eas-cli": "^21.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:engine": "cd supabase/functions/understanding-engine && deno test --allow-read=../../migrations",
    "test:provider-search": "cd supabase/functions/provider-search && deno test",
    "test:visitprep": "deno test --sloppy-imports src/lib/visitPrep.test.ts",
    "test:tampon": "deno test --sloppy-imports src/lib/tamponWear.test.ts",
    "test:onboarding": "deno test --sloppy-imports src/lib/onboardingConversation.test.ts src/lib/onboardingComplete.test.ts src/lib/onboardingSetup.test.ts",
    "test:care": "deno test --sloppy-imports src/lib/careConnection.test.ts",
    "test:glass": "deno test --sloppy-imports src/lib/liquidGlass.test.ts src/lib/navAdaptivity.test.ts",
    "test:copy": "deno test --allow-read --sloppy-imports src/lib/copyNoEmDash.test.ts",
    "test:constellation": "deno test --sloppy-imports src/lib/constellation.test.ts",
    "test:all": "npm run test:engine && npm run test:provider-search && npm run test:visitprep && npm run test:tampon && npm run test:onboarding && npm run test:care && npm run test:glass && npm run test:constellation && npm run test:copy"
  },
  "private": true
}
